# Node (app)
node_modules/

# Build output
dist/
build/

# Données / samples
samples/
*.jpg
*.png
!app/android/app/src/main/res/mipmap-*/*.png
# Icône de la fiche Google Play (app/scripts/brand/render-icons.mjs)
!app/store/*.png
# Images de test du pipeline visage (domaine public, voir leur README)
!app/android/app/src/test/resources/face/*.png

# IDE
.idea/
.vscode/
*.swp
*.swo

# Android SDK (local build, do not commit)
android-sdk/
local.properties

# Base de données locale (données personnelles)
healthtrack.db
*.db
*.sqlite
*.sqlite3

# Fichiers de secrets locaux
*.pem
*.p12
*.pfx
*.keystore
*.jks
# Exception : debug.keystore partagé pour garantir une signature cohérente entre les builds CI
!app/android/app/debug.keystore
google-services.json

# OS
.DS_Store
Thumbs.db

# Env files
.env
.env.*
!.env.example

# Captures de la vérification visuelle (npm run visual)
app/.visual/
app/.perf/
