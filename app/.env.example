# App version / build ID. Set at build time so the in-app update banner
# (GitHub Releases) compares the correct version.
# Example: git commit SHA, CI run number, or semver (1.0.1)
# VITE_APP_VERSION=1.0.0

# Optional: one Withings developer app for all users (official APK builds only).
# End users never see these — they connect via Health Connect on Android.
# VITE_WITHINGS_CLIENT_ID=
# VITE_WITHINGS_CLIENT_SECRET=
# VITE_WITHINGS_REDIRECT_URI=com.healthtrack.app://connectors/withings/callback
