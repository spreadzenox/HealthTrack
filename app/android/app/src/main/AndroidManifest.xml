<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Montre en appareil compagnon (CompanionPlugin.java, WatchPresenceService.java) : Android lie ce
             service quand la montre associée se connecte au téléphone → resynchro sans ouvrir l'app (I72). -->
        <service
            android:name=".WatchPresenceService"
            android:exported="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE"
            tools:targetApi="tiramisu">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>

        <!-- Filet de la relecture app tuée (WatchSyncJob.java) : toutes les ~2 h, gardé après un redémarrage. -->
        <service
            android:name=".WatchSyncJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Lecture du visage (FaceSenseService.java, journal/IDEES.md I88) : service caméra de premier plan, démarré
             seulement depuis l'app ouverte (FaceSensePlugin) ; rafales au déverrouillage, scores seuls gardés. -->
        <service
            android:name=".FaceSenseService"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <!-- Lecture du visage arrêtée → notification « Reprendre » (FaceResumeNotice.java, I88 ②) : vérification
             toutes les ~heures, et tout de suite après un redémarrage ou une mise à jour de l'app. -->
        <service
            android:name=".FaceResumeJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver
            android:name=".FaceResumeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Note du soir d'un geste (EveningNoteNotice.java, I113) : alarme du soir et gestes sur la notification
             (non exporté), alarme reprogrammée après un redémarrage ou une mise à jour. -->
        <receiver
            android:name=".EveningNoteReceiver"
            android:exported="false" />
        <receiver
            android:name=".EveningNoteBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- Montre Huawei en direct (AppManagerPlugin.java) : ouvrir la boîte de désinstallation de l'app qui tient
         la montre (Huawei Santé, Gadgetbridge…). L'utilisateur confirme toujours ; rien n'est désinstallé en silence. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Présence de la montre associée (CompanionPlugin.java) : permission normale, accordée à l'installation. -->
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE" />
    <uses-feature android:name="android.software.companion_device_setup" android:required="false" />
    <!-- Filet de synchro de la montre gardé après un redémarrage (WatchSyncJob, setPersisted). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Seule notification : « synchro de la montre en pause » si elle refuse la clé app fermée (WatchNotifications). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lecture du visage (FaceSenseService.java) : caméra frontale au déverrouillage, images analysées sur le
         téléphone puis effacées ; service de premier plan de type caméra, sortie de l'optimisation de batterie
         demandée par un bouton (boîte d'Android, l'utilisateur confirme). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <!-- Temps d'écran et sommeil estimé par le téléphone (PhoneUsagePlugin.java, src/services/phoneUsage.js) :
         seulement les événements écran allumé / éteint / déverrouillé, rien ne quitte le téléphone.
         Accès spécial accordé par l'utilisateur dans Paramètres → Accès aux données d'utilisation. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Capteurs Bluetooth (src/devices/ble, @capacitor-community/bluetooth-le) : sur Android 12+, la recherche
         ne sert jamais à localiser l'utilisateur (neverForLocation) → pas d'autorisation de position demandée.
         La position précise n'est nécessaire qu'au scan BLE d'Android 11 et moins.
         Position approximative (toutes versions) : météo / pression / air (src/services/weather.js), demandée
         seulement si l'utilisateur touche « Utiliser ma position approximative », arrondie à ≈ 10 km. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!-- Required for Android 11+ package-visibility rules.
         @capacitor/app-launcher uses these to resolve intents for custom URL
         schemes and package IDs. Without these declarations the OS silently
         prevents intent resolution for the listed apps/schemes. -->
    <queries>
        <!-- Health Connect: system module (Android 14+) -->
        <package android:name="com.google.android.healthconnect.controller" />
        <!-- Health Connect: standalone APK (Android 8–13) -->
        <package android:name="com.google.android.apps.healthdata" />
        <!-- Samsung Health app -->
        <package android:name="com.sec.android.app.shealth" />
        <!-- Samsung Device Care : « Applis jamais en veille » (FaceSensePlugin.openNeverSleep) -->
        <package android:name="com.samsung.android.lool" />
        <!-- « Mes appareils » (src/devices/healthApps.js) : apps santé / montres détectées.
             Toute app ajoutée au catalogue doit être déclarée ici (vérifié par healthApps.test.js). -->
        <package android:name="com.huawei.health" />
        <package android:name="com.hihonor.health" />
        <package android:name="nodomain.freeyourgadget.gadgetbridge" />
        <package android:name="nodomain.freeyourgadget.gadgetbridge.nightly" />
        <package android:name="nl.appyhapps.healthsync" />
        <package android:name="com.huami.watch.hmwatchmanager" />
        <package android:name="com.xiaomi.hm.health" />
        <package android:name="com.mi.health" />
        <package android:name="com.xiaomi.wearable" />
        <package android:name="com.garmin.android.apps.connectmobile" />
        <package android:name="com.fitbit.FitbitMobile" />
        <package android:name="com.google.android.apps.fitness" />
        <package android:name="com.google.android.apps.wear.companion" />
        <package android:name="com.withings.wiscale2" />
        <package android:name="com.ouraring.oura" />
        <package android:name="fi.polar.polarflow" />
        <package android:name="com.stt.android.suunto" />
        <package android:name="com.yf.smart.coros.dist" />
        <package android:name="com.whoop.android" />
        <package android:name="com.strava" />
        <!-- Samsung Health deep-link scheme -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="samsunghealth" />
        </intent>
        <!-- Google Play Store market:// scheme (used by openGooglePlaySystemUpdates) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <!-- Temps par app (PhoneUsagePlugin.queryAppEvents, I116) : nom et catégorie des apps
             lancées par l'utilisateur, et lanceur à ignorer. Rien ne quitte le téléphone. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Sonde vocale (VoiceProbePlugin, I124) : moteurs de reconnaissance vocale installés
             (requis par SpeechRecognizer depuis Android 11). Aucun micro ouvert. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
</manifest>
