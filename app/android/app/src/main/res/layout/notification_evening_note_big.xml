<?xml version="1.0" encoding="utf-8"?>
<!-- Note du soir d'un geste (EveningNoteNotice.java, I113) : les 6 notes de l'échelle, 0 = très bas, 5 = très bien. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Votre soirée ? 0 = très bas, 5 = très bien"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Un geste suffit : la note est rangée à la prochaine ouverture de HealthTrack."
        android:textAppearance="@android:style/TextAppearance.Material.Notification" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/evening_note_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="0"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textSize="20sp"
            android:contentDescription="Note 0 sur 5" />
        <TextView
            android:id="@+id/evening_note_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textSize="20sp"
            android:contentDescription="Note 1 sur 5" />
        <TextView
            android:id="@+id/evening_note_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="2"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textSize="20sp"
            android:contentDescription="Note 2 sur 5" />
        <TextView
            android:id="@+id/evening_note_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="3"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textSize="20sp"
            android:contentDescription="Note 3 sur 5" />
        <TextView
            android:id="@+id/evening_note_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="4"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textSize="20sp"
            android:contentDescription="Note 4 sur 5" />
        <TextView
            android:id="@+id/evening_note_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="5"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textSize="20sp"
            android:contentDescription="Note 5 sur 5" />
    </LinearLayout>
</LinearLayout>
