<?xml version="1.0" encoding="utf-8"?>
<!-- Variante play AVEC l'interrupteur faceUnlockPlay (POL-1, journal/PLAY-CONFORMITE.md §1 bis) : copie de
     src/play/AndroidManifest.xml qui GARDE le service caméra de premier plan (lecture au déverrouillage, démarrée
     seulement app ouverte, notification permanente avec « Arrêter ») et ses permissions FOREGROUND_SERVICE(_CAMERA).
     Restent retirés : la relance (vérification horaire, redémarrage, mise à jour) et l'exemption de batterie. Toute
     autre différence avec src/play fait échouer src/config/distribution.android.test.js. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <service android:name="com.healthtrack.app.FaceResumeJob" tools:node="remove" />
        <receiver android:name="com.healthtrack.app.FaceResumeReceiver" tools:node="remove" />

        <!-- Rappel de fin d'essai (TrialReminder.java, VC-18b) : l'alarme n'atteint le récepteur que par notre intention
             explicite ; seuls le redémarrage et la mise à jour de l'app viennent du système. -->
        <receiver
            android:name="com.healthtrack.app.TrialReminderReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" tools:node="remove" />

    <!-- Health Connect (journal/IDEES.md I131) : Google Play refuse les types de données déclarés mais non utilisés.
         Le plugin en déclare 41 ; la variante play ne garde que les 15 lectures du connecteur (READ_TYPES de
         src/connectors/HealthConnectConnector.js) : aucune écriture. Liste vérifiée par
         src/config/distribution.android.test.js et scripts/check-play-manifest.sh. -->
    <uses-permission android:name="android.permission.health.READ_BASAL_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BASAL_METABOLIC_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_FLOORS_CLIMBED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_MINDFULNESS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_ACTIVE_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BASAL_BODY_TEMPERATURE" tools:node="remove" />
