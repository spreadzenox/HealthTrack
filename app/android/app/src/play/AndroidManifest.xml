<?xml version="1.0" encoding="utf-8"?>
<!-- Variante play (journal/PLAY-CONFORMITE.md) : la lecture du visage n'a lieu qu'app à l'écran (FaceOneShot, à
     l'ouverture de l'app ou au bouton « Tester »). Retirés ici : le service caméra de premier plan qui lit au
     déverrouillage, sa relance (vérification horaire, redémarrage, mise à jour) et l'exemption de batterie, que les
     règles Google Play ne permettent pas de justifier pour cette fonction. Vérifié par scripts/check-play-manifest.sh. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <service android:name="com.healthtrack.app.FaceSenseService" tools:node="remove" />
        <service android:name="com.healthtrack.app.FaceResumeJob" tools:node="remove" />
        <receiver android:name="com.healthtrack.app.FaceResumeReceiver" tools:node="remove" />
    </application>

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" tools:node="remove" />

    <!-- Health Connect (journal/IDEES.md I131) : Google Play refuse les types de données déclarés mais non utilisés.
         Le plugin en déclare 41 ; la variante play ne garde que les 15 lectures du connecteur (READ_TYPES de
         src/connectors/HealthConnectConnector.js) : aucune écriture. Liste vérifiée par
         src/config/distribution.android.test.js et scripts/check-play-manifest.sh. -->
    <uses-permission android:name="android.permission.health.READ_BASAL_BODY_TEMPERATURE" tools:node="remove" />
